    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b77bbbe7-97bc-495e-88bd-5a21a327dbc2</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
