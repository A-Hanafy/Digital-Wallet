# =====================================================================
# Digital Wallet - Docker Compose environment
# Copy this file to `.env` and fill in real values. `.env` must never
# be committed to source control (it is already listed in .dockerignore;
# ensure it is also in .gitignore).
# =====================================================================

# ------------------------------ SQL Server ---------------------------
# SA password. Compose only sets the container password with this value;
# the SQL Server image enforces complexity rules, so it must contain:
#   - at least 8 characters
#   - three of the four categories: uppercase, lowercase, digits, symbols
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Auto-startup license acceptance (Y or N)
ACCEPT_EULA=Y

# Edition to run without a paid license: Developer (default), Express
MSSQL_PID=Developer

# Host port for local dev tooling only (SSMS / Azure Data Studio)
MSSQL_HOST_PORT=1433

# ------------------------------ Database -----------------------------
DATABASE_NAME=Digital_Wallet

# ------------------------------ Web API ------------------------------
APP_HOST_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------ Security -----------------------------
# Overrides the (publicly committed) JWT key from appsettings.json.
# Must be at least 64 characters; keep it out of source control.
JWT__KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG_xxxxxxxxxxxxxxxxxxxx
